{
  "name": "@pmndrs/ink-splat",
  "version": "0.0.1",
  "private": true,
  "description": "Novel pmndrs design-system components, starting from Kris's ink splat experiment",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --noEmit",
    "typecheck:watch": "tsc --build --watch",
    "lint": "oxlint -c .config/oxlint.json",
    "format": "prettier --config .config/prettier.json --ignore-path .config/prettierignore --write .",
    "lgtm": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "leva": "^0.10.1",
    "maath": "^0.10.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.182.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "three": "~0.182.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  }
}
